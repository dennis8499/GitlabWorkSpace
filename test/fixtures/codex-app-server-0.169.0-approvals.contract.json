{
  "version": "0.169.0",
  "source": "Official locally installed @openai/codex CLI, app-server generate-json-schema",
  "coverage": "Approval inventory and exact thread/delete subset captured from local schema generation; no model turn, account request or native user-thread deletion was made.",
  "threadDelete": {
    "capture": ["app-server", "generate-json-schema", "--experimental"],
    "method": "thread/delete",
    "params": { "type": "object", "properties": { "threadId": { "type": "string" } }, "required": ["threadId"] },
    "response": { "type": "object" }
  },
  "commandApproval": {
    "properties": ["approvalId", "command", "commandActions", "cwd", "environmentId", "itemId", "kind", "networkApprovalContext", "proposedExecpolicyAmendment", "proposedNetworkPolicyAmendments", "reason", "startedAtMs", "threadId", "turnId"],
    "required": ["itemId", "startedAtMs", "threadId", "turnId"],
    "kindDefault": "command",
    "kinds": ["command", "writeStdin", "humanCommand"],
    "humanCommandRequiresFreshHumanDecision": true,
    "environmentIdDefault": null
  },
  "fileApproval": {
    "properties": ["grantRoot", "itemId", "reason", "startedAtMs", "threadId", "turnId"],
    "required": ["itemId", "startedAtMs", "threadId", "turnId"],
    "grantRootIsSessionWriteGrant": true
  }
}
