{
  "name": "gitlab-workspace",
  "displayName": "GitLab Workspace",
  "description": "在 VS Code 的單一工作台瀏覽專案、需求、Issue 與 Merge Request。",
  "version": "0.12.0",
  "publisher": "local-dev",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/dennis8499/GitlabWorkSpace.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onCommand:gitlabWorkspace.openWorkspace",
    "onCommand:gitlabWorkspace.openCloneMode",
    "onCommand:gitlabWorkspace.openSaMode",
    "onCommand:gitlabWorkspace.openDeveloperMode",
    "onCommand:gitlabWorkspace.openReviewerMode",
    "onCommand:gitlabWorkspace.openGitMode",
    "onCommand:gitlabWorkspace.openRepository",
    "onView:gitlabWorkspace.quickActions",
    "onCommand:gitlabWorkspace.connect",
    "onCommand:gitlabWorkspace.selectGroup",
    "onCommand:gitlabWorkspace.syncLocalDefaultBranches"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitlabWorkspace",
          "title": "GitLab Workspace",
          "icon": "resources/gitlab-workspace.svg"
        }
      ]
    },
    "views": {
      "gitlabWorkspace": [
        {
          "type": "webview",
          "id": "gitlabWorkspace.quickActions",
          "name": "工作台導覽",
          "contextualTitle": "GitLab Workspace 工作台導覽",
          "icon": "resources/gitlab-workspace.svg",
          "visibility": "visible",
          "initialSize": 2
        }
      ]
    },
    "commands": [
      {
        "command": "gitlabWorkspace.openWorkspace",
        "title": "GitLab Workspace: 開啟工作台",
        "shortTitle": "開啟工作台",
        "icon": "$(layout)"
      },
      {
        "command": "gitlabWorkspace.openCloneMode",
        "title": "GitLab Workspace: 專案"
      },
      {
        "command": "gitlabWorkspace.openSaMode",
        "title": "GitLab Workspace: Codebase LLM Wiki"
      },
      {
        "command": "gitlabWorkspace.openDeveloperMode",
        "title": "GitLab Workspace: 我的工作"
      },
      {
        "command": "gitlabWorkspace.openReviewerMode",
        "title": "GitLab Workspace: 待審查"
      },
      {
        "command": "gitlabWorkspace.openGitMode",
        "title": "GitLab Workspace: 開啟版控"
      },
      {
        "command": "gitlabWorkspace.openRepository",
        "title": "GitLab Workspace: 開啟 Repo 版控"
      },
      {
        "command": "gitlabWorkspace.connect",
        "title": "GitLab Workspace: 連線 GitLab",
        "shortTitle": "連線 GitLab",
        "icon": "$(plug)"
      },
      {
        "command": "gitlabWorkspace.selectGroup",
        "title": "GitLab Workspace: 選擇 Group",
        "shortTitle": "選擇 Group",
        "icon": "$(organization)"
      },
      {
        "command": "gitlabWorkspace.refresh",
        "title": "GitLab Workspace: 重新整理工作台",
        "shortTitle": "重新整理",
        "icon": "$(refresh)"
      },
      {
        "command": "gitlabWorkspace.cloneRepositories",
        "title": "GitLab Workspace: 選擇要下載或更新的專案"
      },
      {
        "command": "gitlabWorkspace.cloneAllRepositories",
        "title": "GitLab Workspace: 下載或更新全部專案",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitlabWorkspace.cloneSelectedRepositories",
        "title": "GitLab Workspace: 下載或更新選取專案",
        "icon": "$(checklist)"
      },
      {
        "command": "gitlabWorkspace.syncLocalDefaultBranches",
        "title": "GitLab Workspace: 更新本機預設分支",
        "icon": "$(sync)"
      },
      {
        "command": "gitlabWorkspace.createIssue",
        "title": "GitLab Workspace: 新增 Issue"
      },
      {
        "command": "gitlabWorkspace.disconnect",
        "title": "GitLab Workspace: 中斷連線"
      },
      {
        "command": "gitlabWorkspace.openIssue",
        "title": "GitLab Workspace: 開啟 Issue 詳情"
      }
    ],
    "configuration": {
      "title": "GitLab Workspace",
      "properties": {
        "gitlabWorkspace.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "匯入、檢查及安裝工具套件時使用的 Python 3.11+ 執行檔路徑。"
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/clean-compiled.mjs && tsc -p .",
    "typecheck:webview": "tsc -p tsconfig.webview.json",
    "build:webview": "npm run typecheck:webview && vite build --config vite.dashboard.config.mjs && vite build --config vite.sidebar.config.mjs",
    "watch": "tsc -watch -p .",
    "test:unit": "npm run compile && node --test out/test/unit/*.test.js",
    "benchmark:performance": "npm run compile && node --expose-gc scripts/performance-benchmark.cjs",
    "test:behavior": "npm run compile && npm run build:webview && vite build --config vite.issue-test.config.mjs && node --test test/behavior/quick-actions.test.mjs test/behavior/dashboard.test.mjs && cucumber-js --require test/behavior/steps.cjs --tags @automated test/behavior/issues.feature && cucumber-js --require test/behavior/connect.steps.cjs --tags @automated test/behavior/connect.feature",
    "test:extension": "npm run compile && vscode-test",
    "test:release": "node --test scripts/python-runtime.test.mjs scripts/release-policy.test.mjs scripts/release-workflow.test.mjs && node scripts/run-python.mjs scripts/build-workflow-kit.py && node scripts/run-python.mjs test/release/tool_installer_test.py && node scripts/run-python.mjs test/release/workflow_kit_installer_test.py && node scripts/run-python.mjs test/release/group_workflow_test.py",
    "test": "npm run test:unit && npm run test:behavior && npm run package && npm run test:release && npm run test:extension",
    "check:release": "node scripts/check-release.mjs",
    "package": "npm run compile && npm run build:webview && node scripts/package-extension.mjs && node scripts/run-python.mjs scripts/verify-vsix.py",
    "verify:package": "node scripts/run-python.mjs scripts/verify-vsix.py",
    "vscode:prepublish": "npm run compile && npm run build:webview"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/d3-force": "^3.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.6",
    "@vscode/test-cli": {
      "diff": "^8.0.4"
    }
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "preact": "^10.29.8"
  }
}
