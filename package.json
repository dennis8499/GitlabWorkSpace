{
  "activationEvents": [
    "onCommand:gitlabWorkspace.openWorkspace",
    "onCommand:gitlabWorkspace.openNotifications",
    "onCommand:gitlabWorkspace.openSettings",
    "onCommand:gitlabWorkspace.openCloneMode",
    "onCommand:gitlabWorkspace.openSaMode",
    "onCommand:gitlabWorkspace.openBmadMode",
    "onCommand:gitlabWorkspace.openDeveloperMode",
    "onCommand:gitlabWorkspace.openReviewerMode",
    "onCommand:gitlabWorkspace.openGitMode",
    "onCommand:gitlabWorkspace.openCodexMode",
    "onCommand:gitlabWorkspace.createCodexTask",
    "onCommand:gitlabWorkspace.createCodexTaskFromSelection",
    "onCommand:gitlabWorkspace.openRepository",
    "onCommand:gitlabWorkspace.connect",
    "onCommand:gitlabWorkspace.selectGroup",
    "onCommand:gitlabWorkspace.syncLocalDefaultBranches",
    "onCommand:gitlabWorkspace.addAccount",
    "onCommand:gitlabWorkspace.manageAccounts",
    "onCommand:gitlabWorkspace.switchAccount",
    "onCommand:gitlabWorkspace.removeAccount",
    "onCommand:gitlabWorkspace.openAdmin",
    "onCommand:gitlabWorkspace.showLogs",
    "onCommand:gitlabWorkspace.scanRepositories",
    "onView:gitlabWorkspace.repositories",
    "onView:gitlabWorkspace.myWork"
  ],
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "本機 Git、Skills 與 Codex 會讀寫專案或執行工具，需要受信任的工作區。"
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "可使用 GitLab 帳號、Issue 與 Merge Request；Repo 掃描、Git、Clone／同步、Skills、本機審查與 Codex 需要磁碟上的專案資料夾。"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gitlabWorkspace.createCodexTask",
        "title": "建立 Codex 任務",
        "category": "GitLab Workspace",
        "icon": "$(add)"
      },
      {
        "command": "gitlabWorkspace.createCodexTaskFromSelection",
        "title": "將選取文字帶入 Codex 任務",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openNotifications",
        "title": "訊息中心",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openSettings",
        "title": "設定",
        "category": "GitLab Workspace",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gitlabWorkspace.openTools",
        "title": "工具與環境",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openWorkspace",
        "icon": "$(layout)",
        "shortTitle": "開啟工作台",
        "title": "開啟工作台",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openCloneMode",
        "title": "專案",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openSaMode",
        "title": "Skills 功能指引",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openBmadMode",
        "title": "BMAD 開發流程",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openDeveloperMode",
        "title": "我的工作",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openReviewerMode",
        "title": "待審查",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openCodexMode",
        "title": "開啟 Codex",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openGitMode",
        "title": "開啟版控",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openRepository",
        "title": "開啟 Repo 版控",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.connect",
        "icon": "$(plug)",
        "shortTitle": "連線 GitLab",
        "title": "連線 GitLab",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.selectGroup",
        "icon": "$(organization)",
        "shortTitle": "選擇 Group",
        "title": "選擇 Group",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.refresh",
        "icon": "$(refresh)",
        "shortTitle": "重新整理",
        "title": "重新整理工作台",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.cloneRepositories",
        "title": "選擇要下載或更新的專案",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.cloneAllRepositories",
        "icon": "$(cloud-download)",
        "title": "下載或更新全部專案",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.cloneSelectedRepositories",
        "icon": "$(checklist)",
        "title": "下載或更新選取專案",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.syncLocalDefaultBranches",
        "icon": "$(sync)",
        "title": "更新全部本機預設分支",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.createIssue",
        "title": "新增 Issue",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.disconnect",
        "title": "中斷連線",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openIssue",
        "title": "開啟 Issue 詳情",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.addAccount",
        "title": "新增 GitLab 帳號",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.manageAccounts",
        "title": "管理 GitLab 帳號",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.switchAccount",
        "title": "切換 GitLab 帳號",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.removeAccount",
        "title": "移除 GitLab 帳號",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.openAdmin",
        "title": "開啟 Log（相容命令）",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.showLogs",
        "title": "開啟 Log",
        "category": "GitLab Workspace"
      },
      {
        "command": "gitlabWorkspace.scanRepositories",
        "title": "一鍵掃描工作區 Repo",
        "category": "GitLab Workspace",
        "icon": "$(search)"
      },
      {
        "command": "gitlabWorkspace.selectWorkflow",
        "title": "切換工作流程…",
        "category": "GitLab Workspace",
        "icon": "$(list-selection)"
      },
      {
        "command": "gitlabWorkspace.refreshRepositories",
        "title": "重新整理儲存庫",
        "category": "GitLab Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "gitlabWorkspace.refreshMyWork",
        "title": "重新整理我的工作",
        "category": "GitLab Workspace",
        "icon": "$(refresh)",
        "enablement": "gitlabWorkspace.connected && gitlabWorkspace.hasGroup"
      },
      {
        "command": "gitlabWorkspace.findRepositories",
        "title": "尋找儲存庫…",
        "category": "GitLab Workspace",
        "icon": "$(search)"
      },
      {
        "command": "gitlabWorkspace.findMyWork",
        "title": "尋找 Issue 或 MR…",
        "category": "GitLab Workspace",
        "icon": "$(search)",
        "enablement": "gitlabWorkspace.connected && gitlabWorkspace.hasGroup"
      },
      {
        "command": "gitlabWorkspace.openMergeRequest",
        "title": "開啟 MR 詳情",
        "category": "GitLab Workspace",
        "icon": "$(git-pull-request)"
      }
    ],
    "configuration": {
      "properties": {
        "gitlabWorkspace.codex.maxConcurrentTasks": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 2,
          "scope": "machine",
          "description": "本機所有視窗共用的 Codex 任務上限。預設 1；設為 2 時，只有沒有共用寫入資源的任務才會同時執行。"
        },
        "gitlabWorkspace.codex.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Codex CLI 執行檔的完整路徑；留白從 PATH 偵測。只讀取使用者設定，支援官方 npm 安裝入口。需要 Codex CLI 0.165.0 或更新版本。"
        },
        "gitlabWorkspace.projectRoot": {
          "default": "",
          "description": "專案下載、Skills 安裝與執行共用的根目錄。留白使用所選 VS Code 專案資料夾；相對路徑以該資料夾為基準。",
          "scope": "resource",
          "type": "string"
        },
        "gitlabWorkspace.pythonPath": {
          "default": "python",
          "description": "匯入、檢查及安裝工具套件時使用的 Python 3.11+ 執行檔路徑。",
          "type": "string"
        },
        "gitlabWorkspace.repositoryScan.excludeDirectories": {
          "default": [
            ".git",
            "node_modules",
            ".venv",
            ".review-runtime",
            ".release-review-runtime",
            ".review-shared-cache"
          ],
          "description": "一鍵掃描略過的資料夾名稱；.git 永遠不遞迴。修改後重新掃描即可套用。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gitlabWorkspace.reviewRuntimePath": {
          "default": "",
          "description": "審查任務與快取的外部可寫目錄。Merge 直接使用此目錄，Release 使用其 release-reviewer 子目錄；兩套資料獨立。群組工作區留白分別使用 .review-runtime 與 .release-review-runtime；單 Repo 必須指定 Git Repo 外目錄。",
          "scope": "resource",
          "type": "string"
        }
      },
      "title": "GitLab Workspace"
    },
    "menus": {
      "commandPalette": [
        {
          "command": "gitlabWorkspace.openAdmin",
          "when": "false"
        },
        {
          "command": "gitlabWorkspace.openMergeRequest",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gitlabWorkspace.scanRepositories",
          "when": "view == gitlabWorkspace.repositories",
          "group": "navigation@1"
        },
        {
          "command": "gitlabWorkspace.openWorkspace",
          "when": "view == gitlabWorkspace.repositories",
          "group": "navigation@2"
        },
        {
          "command": "gitlabWorkspace.refreshRepositories",
          "when": "view == gitlabWorkspace.repositories",
          "group": "repositories@1"
        },
        {
          "command": "gitlabWorkspace.findRepositories",
          "when": "view == gitlabWorkspace.repositories",
          "group": "repositories@2"
        },
        {
          "command": "gitlabWorkspace.selectWorkflow",
          "when": "view == gitlabWorkspace.repositories",
          "group": "workspace@1"
        },
        {
          "command": "gitlabWorkspace.openSettings",
          "when": "view == gitlabWorkspace.repositories",
          "group": "workspace"
        },
        {
          "command": "gitlabWorkspace.openTools",
          "when": "view == gitlabWorkspace.repositories",
          "group": "workspace"
        },
        {
          "command": "gitlabWorkspace.manageAccounts",
          "when": "view == gitlabWorkspace.repositories",
          "group": "workspace"
        },
        {
          "command": "gitlabWorkspace.selectGroup",
          "when": "view == gitlabWorkspace.repositories",
          "group": "workspace"
        },
        {
          "command": "gitlabWorkspace.openWorkspace",
          "when": "view == gitlabWorkspace.myWork",
          "group": "navigation@1"
        },
        {
          "command": "gitlabWorkspace.refreshMyWork",
          "when": "view == gitlabWorkspace.myWork",
          "group": "navigation@2"
        },
        {
          "command": "gitlabWorkspace.findMyWork",
          "when": "view == gitlabWorkspace.myWork",
          "group": "work@1"
        },
        {
          "command": "gitlabWorkspace.selectWorkflow",
          "when": "view == gitlabWorkspace.myWork",
          "group": "workspace@1"
        },
        {
          "command": "gitlabWorkspace.openSettings",
          "when": "view == gitlabWorkspace.myWork",
          "group": "workspace"
        },
        {
          "command": "gitlabWorkspace.openTools",
          "when": "view == gitlabWorkspace.myWork",
          "group": "workspace"
        },
        {
          "command": "gitlabWorkspace.manageAccounts",
          "when": "view == gitlabWorkspace.myWork",
          "group": "workspace"
        },
        {
          "command": "gitlabWorkspace.selectGroup",
          "when": "view == gitlabWorkspace.myWork",
          "group": "workspace"
        }
      ],
      "view/item/context": [
        {
          "command": "gitlabWorkspace.openRepository",
          "when": "view == gitlabWorkspace.repositories && viewItem == gitlabWorkspace.repository",
          "group": "inline"
        },
        {
          "command": "gitlabWorkspace.openIssue",
          "when": "view == gitlabWorkspace.myWork && viewItem == gitlabWorkspace.issue",
          "group": "inline"
        },
        {
          "command": "gitlabWorkspace.openMergeRequest",
          "when": "view == gitlabWorkspace.myWork && viewItem == gitlabWorkspace.mergeRequest",
          "group": "inline"
        },
        {
          "command": "gitlabWorkspace.openDeveloperMode",
          "when": "view == gitlabWorkspace.myWork",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "gitlabWorkspace": [
        {
          "id": "gitlabWorkspace.repositories",
          "name": "儲存庫",
          "contextualTitle": "GitLab Workspace 儲存庫",
          "visibility": "visible"
        },
        {
          "id": "gitlabWorkspace.myWork",
          "name": "我的工作",
          "contextualTitle": "GitLab Workspace 我的工作",
          "visibility": "visible"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "icon": "resources/gitlab-workspace.svg",
          "id": "gitlabWorkspace",
          "title": "GitLab Workspace"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitlabWorkspace.repositories",
        "contents": "目前沒有已登錄的本機 Repo。\n[掃描工作區 Repo](command:gitlabWorkspace.scanRepositories)\n[開啟工作台](command:gitlabWorkspace.openWorkspace)"
      },
      {
        "view": "gitlabWorkspace.myWork",
        "when": "!gitlabWorkspace.connected",
        "contents": "登入 GitLab 後可瀏覽指派給我的 Issue 與 Group 的 MR。\n[連線 GitLab](command:gitlabWorkspace.connect)"
      },
      {
        "view": "gitlabWorkspace.myWork",
        "when": "gitlabWorkspace.connected && !gitlabWorkspace.hasGroup",
        "contents": "選擇 Group 以載入工作項目。\n[選擇 Group](command:gitlabWorkspace.selectGroup)"
      }
    ]
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "preact": "^10.29.8",
    "yaml": "^2.9.1"
  },
  "description": "在 VS Code 的單一工作台瀏覽專案、需求、Issue 與 Merge Request。",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.1",
    "playwright-core": "1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "displayName": "GitLab Workspace",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "license": "UNLICENSED",
  "main": "./out/src/extension.js",
  "name": "gitlab-workspace",
  "overrides": {
    "@vscode/test-cli": {
      "diff": "^8.0.4"
    },
    "serialize-javascript": "^7.0.6"
  },
  "publisher": "local-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/dennis8499/GitlabWorkSpace.git"
  },
  "scripts": {
    "benchmark:live": "npm run package && node scripts/run-live-extension-tests.mjs --benchmark",
    "benchmark:performance": "npm run compile && node --expose-gc scripts/performance-benchmark.cjs",
    "build:dev": "npm run compile && npm run build:webview",
    "build:webview": "npm run typecheck:webview && vite build --config vite.dashboard.config.mjs && vite build --config vite.sidebar.config.mjs",
    "check:release": "node scripts/check-release.mjs",
    "compile": "node scripts/clean-compiled.mjs && tsc -p .",
    "lint": "eslint . --max-warnings 0",
    "package": "node scripts/run-validation.mjs package",
    "package:prepared": "node scripts/run-validation.mjs package --prepared",
    "prepare:validation": "node scripts/run-validation.mjs prepare",
    "test": "node scripts/run-validation.mjs all",
    "test:codex:live": "node scripts/run-codex-live-tests.mjs",
    "test:behavior": "node scripts/run-validation.mjs behavior",
    "test:behavior:prepared": "node scripts/run-validation.mjs behavior --prepared",
    "test:extension": "node scripts/run-validation.mjs extension",
    "test:extension:prepared": "node scripts/run-validation.mjs extension --prepared",
    "test:git-gui": "npm run package && node scripts/run-live-extension-tests.mjs --git-gui",
    "test:git-gui:local": "npm run package && node scripts/run-live-extension-tests.mjs --local-git-gui",
    "test:live": "npm run package && node scripts/run-live-extension-tests.mjs",
    "test:release": "node scripts/run-validation.mjs release",
    "test:release:prepared": "node scripts/run-validation.mjs release --prepared",
    "test:unit": "node scripts/run-validation.mjs unit",
    "test:trust": "node scripts/run-validation.mjs trust",
    "test:unit:prepared": "node scripts/run-validation.mjs unit --prepared",
    "typecheck:webview": "tsc -p tsconfig.webview.json",
    "verify:package": "node scripts/run-python.mjs scripts/verify-vsix.py",
    "vscode:prepublish": "node scripts/run-validation.mjs prepublish",
    "watch": "tsc -watch -p ."
  },
  "version": "0.43.0"
}
