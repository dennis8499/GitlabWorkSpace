{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run GitLab Workspace Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/out/src/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
