{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src/webview/**/*.tsx", "src/issues/protocol.ts", "src/api/types.ts", "src/api/gitLabClient.ts", "src/workspace/quickActionsProtocol.ts"]
}
